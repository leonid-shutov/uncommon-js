{
  "name": "@leonid-shutov/uncommonjs",
  "version": "1.0.0",
  "description": "Convention over configuration for JavaScript",
  "keywords": [
    "convention-over-configuration",
    "autoload",
    "loader",
    "dependency-injection",
    "sandbox",
    "vm",
    "module-system",
    "no-imports"
  ],
  "author": "Leonid Shutov <leonid.shutov@hey.com>",
  "license": "MIT",
  "homepage": "https://github.com/leonid-shutov/uncommon-js#readme",
  "bugs": {
    "url": "https://github.com/leonid-shutov/uncommon-js/issues"
  },
  "main": "uncommon.js",
  "exports": {
    ".": "./uncommon.js",
    "./package.json": "./package.json"
  },
  "files": [
    "uncommon.js",
    "lib"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test test/test.js",
    "lint": "eslint .",
    "fmt": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonid-shutov/uncommon-js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "eslint": "^10.10.0",
    "eslint-config-metarhia": "^9.2.1",
    "prettier": "^3.9.6"
  }
}
